{
  "name": "zyntax-ai",
  "version": "1.0.2",
  "private": true,
  "description": "ZyntaxAI \u2014 cross-platform AI writing assistant",
  "scripts": {
    "dev": "pnpm --filter @zyntax/desktop dev",
    "build": "pnpm --filter @zyntax/desktop build",
    "typecheck": "pnpm --filter @zyntax/desktop typecheck",
    "test": "pnpm --filter @zyntax/desktop test",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "release": "node scripts/release.mjs",
    "site:sync": "node scripts/site-sync.mjs",
    "rs:test": "node scripts/test-rust.mjs",
    "rs:lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rs:fmt": "cargo fmt --all",
    "rs:fmt:check": "cargo fmt --all -- --check",
    "lint": "biome lint --error-on-warnings && pnpm rs:fmt:check && pnpm rs:lint",
    "bindings:check": "node scripts/check-bindings.mjs",
    "release:test": "node --test scripts/release-utils.test.mjs",
    "check": "pnpm lint && pnpm release:test && pnpm rs:test && pnpm bindings:check && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.11.4",
    "husky": "^9.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "license": "GPL-3.0-or-later"
}
